# ===== نمونه فایل تنظیمات — آن را به «.env.» کپی کنید =====
# مسیر دیتابیس SQLite (نسبت به پوشه prisma/ محاسبه می‌شود — نیازی به تغییر نیست)
DATABASE_URL=file:../db/custom.db

# کلید امضای توکن‌های ورود — در استقرار واقعی یک رشته تصادفی طولانی بگذارید
# (مثلاً خروجی: openssl rand -hex 32)
# JWT_SECRET=change-me-to-a-long-random-string

# محل ذخیره اسناد بارگذاری‌شده (اختیاری — پیش‌فرض: پوشه uploads کنار پروژه)
# UPLOAD_DIR=/tmp/uploads
